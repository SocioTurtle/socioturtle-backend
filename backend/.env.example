APP_NAME=Socioturtle
ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

DATABASE_URL=sqlite:///./socioturtle.db

# local | hcaptcha
CAPTCHA_PROVIDER=local
CAPTCHA_TTL_SECONDS=300
HCAPTCHA_SECRET=

LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE=logs/app.log

# Origins allowed to call this API. Must include the marketing site that hosts
# the registration widget, otherwise the browser blocks the request.
CORS_ORIGINS=["http://localhost:5173","https://www.socioturtle.com","https://socioturtle.com"]

# Absolute, externally reachable URLs used to build links inside emails.
# A localhost value here produces dead invite links in real inboxes.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000

# console = log emails instead of sending (safe default, no credentials needed)
# smtp    = deliver for real
EMAIL_BACKEND=console
EMAIL_FROM=hello@socioturtle.com
EMAIL_FROM_NAME=SocioTurtle
EMAIL_REPLY_TO=

# Gmail: smtp.gmail.com / 587 / an App Password (NOT your normal password)
# Zoho:  smtp.zoho.in   / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

INVITE_TTL_HOURS=168
NEWSLETTER_BATCH_PAUSE_SECONDS=0.2
